# Server
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5174

# Database
MONGODB_URI=mongodb://localhost:27017/fitplatform

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin seed account (created by `npm run seed`)
ADMIN_SEED_EMAIL=admin@fitplatform.app
ADMIN_SEED_PASSWORD=ChangeMe123!

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# Kiosk
KIOSK_SESSION_TTL_MINUTES=2
KIOSK_PAIRING_CODE_TTL_MINUTES=10

# Razorpay: configure keys, a public webhook endpoint and capture settings before enabling.
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
